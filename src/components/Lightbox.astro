---
/**
 * Zoom affordance for content images. Every image inside `.prose` or a
 * `[data-zoomable]` container gets a magnifier badge that opens it full
 * screen in a native <dialog> — Escape, focus trapping, and the backdrop
 * come free. Rendered once from the Base layout.
 */
---

<dialog id="lightbox" aria-label="Enlarged image">
  <div class="lb-frame">
    <button type="button" class="lb-close" aria-label="Close enlarged image">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption" class="lb-caption"></p>
  </div>
</dialog>

<script>
  const ZOOM_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none"
    stroke="currentColor" stroke-width="2" stroke-linecap="round"
    stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/>
    <line x1="8" y1="11" x2="14" y2="11"/></svg>`

  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null
  const full = document.getElementById('lightbox-img') as HTMLImageElement | null
  const caption = document.getElementById('lightbox-caption')

  if (dialog && full && caption) {
    const open = (img: HTMLImageElement) => {
      full.src = img.currentSrc || img.src
      full.alt = img.alt
      caption.textContent = img.alt
      caption.hidden = img.alt === ''
      dialog.showModal()
    }

    // Prose images are bare <img> in a <p>; give each one a host to anchor
    // the badge to. Containers that already opt in are left alone.
    for (const img of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      if (img.closest('[data-zoomable]')) continue
      const host = document.createElement('span')
      host.className = 'lb-host'
      host.dataset.zoomable = ''
      img.replaceWith(host)
      host.append(img)
    }

    for (const host of document.querySelectorAll<HTMLElement>('[data-zoomable]')) {
      const img = host.querySelector('img')
      if (!img) continue

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'lb-zoom'
      button.innerHTML = ZOOM_ICON
      button.setAttribute(
        'aria-label',
        img.alt ? `Enlarge image: ${img.alt}` : 'Enlarge image',
      )
      button.addEventListener('click', event => {
        event.preventDefault()
        open(img)
      })
      host.append(button)

      // Where the image is not already a link, clicking it zooms as well.
      if (!img.closest('a')) {
        host.classList.add('lb-host--clickable')
        img.addEventListener('click', () => open(img))
      }
    }

    dialog.addEventListener('click', event => {
      if (event.target === dialog) dialog.close()
    })
    dialog
      .querySelector('.lb-close')
      ?.addEventListener('click', () => dialog.close())
  }
</script>

<style is:global>
  [data-zoomable] {
    position: relative;
  }
  .lb-host {
    display: block;
  }
  .lb-host--clickable img {
    cursor: zoom-in;
  }

  /* Badge sits over the image corner; revealed on hover, always on touch. */
  .lb-zoom {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 6px;
    background: rgb(11 13 16 / 0.78);
    backdrop-filter: blur(6px);
    color: var(--color-fg);
    cursor: zoom-in;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  [data-zoomable]:hover .lb-zoom,
  .lb-zoom:focus-visible {
    opacity: 1;
  }
  .lb-zoom:hover {
    color: var(--color-accent);
    border-color: rgb(251 191 36 / 0.5);
  }
  @media (hover: none) {
    .lb-zoom {
      opacity: 1;
    }
  }

  /* ── Overlay ─────────────────────────────────────────────────────────── */
  #lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-fg);
    overflow: hidden;
  }
  #lightbox::backdrop {
    background: rgb(6 8 11 / 0.97);
  }
  #lightbox[open] {
    animation: lb-in 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  .lb-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: 100%;
    padding: 3.5rem 1.5rem 2rem;
  }
  #lightbox img {
    max-width: min(1240px, 94vw);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-panel);
  }
  .lb-caption {
    max-width: 70ch;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .lb-caption[hidden] {
    display: none;
  }

  .lb-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-panel-2);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .lb-close:hover {
    color: var(--color-accent);
    border-color: rgb(251 191 36 / 0.5);
  }

  @media print {
    .lb-zoom,
    #lightbox {
      display: none !important;
    }
  }
</style>
