---
import Section from './Section.astro'
import { experience } from '../lib/data'
---

<Section id="experience" index="02" title="Experience">
  <div class="flex flex-col gap-12">
    {
      experience.map(entry => (
        <article
          class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]"
          data-reveal
        >
          <div>
            <h3 class="font-semibold text-white">{entry.role}</h3>
            <p class="mt-1 text-sm text-muted">{entry.company}</p>
            <p class="mt-1 font-mono text-xs text-muted">{entry.period}</p>
          </div>
          <ul class="flex flex-col gap-2.5 border-l border-line pl-5">
            {entry.bullets.map(bullet => (
              <li class="text-[15px] leading-relaxed text-muted">
                <span class="mr-2 font-mono text-accent" aria-hidden="true">
                  –
                </span>
                {bullet}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
