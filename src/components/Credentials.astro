---
import Section from './Section.astro'
import { certifications, education, skills, formatMonth } from '../lib/data'
---

<Section id="credentials" index="04" title="Credentials">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div data-reveal>
      <h3 class="mb-4 font-mono text-sm text-muted">certifications</h3>
      <ul class="divide-y divide-line border-y border-line">
        {
          certifications.map(cert => (
            <li>
              <a
                href={cert.verifyUrl}
                class="group flex items-center gap-4 py-3"
                rel="noopener"
              >
                {cert.badge && (
                  <img
                    src={cert.badge}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 shrink-0 object-contain"
                  />
                )}
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[15px] font-medium text-white transition-colors group-hover:text-accent">
                    {cert.title}
                  </span>
                  <span class="block font-mono text-xs text-muted">
                    {cert.issuer} · {formatMonth(cert.date)}
                  </span>
                </span>
                <span
                  class="font-mono text-xs text-muted transition-colors group-hover:text-accent"
                  aria-hidden="true"
                >
                  verify ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-10">
      <div data-reveal>
        <h3 class="mb-4 font-mono text-sm text-muted">education</h3>
        <ul class="flex flex-col gap-4">
          {
            education.map(entry => (
              <li>
                <p class="text-[15px] font-medium text-white">
                  {entry.url ? (
                    <a
                      href={entry.url}
                      class="transition-colors hover:text-accent"
                    >
                      {entry.degree} ↗
                    </a>
                  ) : (
                    entry.degree
                  )}
                </p>
                <p class="font-mono text-xs text-muted">
                  {entry.institution} · {entry.period}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal>
        <h3 class="mb-4 font-mono text-sm text-muted">toolbox</h3>
        <dl class="flex flex-col gap-2.5">
          {
            skills.map(category => (
              <div class="grid grid-cols-[110px_minmax(0,1fr)] gap-3 text-sm">
                <dt class="font-mono text-xs leading-6 text-accent">
                  {category.name.toLowerCase()}
                </dt>
                <dd class="leading-6 text-muted">
                  {category.tools.join(' · ')}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</Section>
