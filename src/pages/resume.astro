---
import Base from '../layouts/Base.astro'
import { site } from '../lib/site'
import {
  certifications,
  education,
  experience,
  formatMonth,
  skills,
} from '../lib/data'
import { headline, metrics, resumeProjects, summary } from '../lib/resume'

/** Strip the scheme so the printed résumé shows clean, typeable addresses. */
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '')

/** "https://github.com/me/repo" → "me/repo" — full URLs crowd the print margin. */
const repo = (url: string) => bare(url).replace(/^github\.com\//, '')

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: bare(site.url), href: site.url },
  { label: bare(site.linkedin), href: site.linkedin },
  { label: bare(site.github), href: site.github },
]

const updated = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
})

const sections = [
  { index: '01', title: 'Summary' },
  { index: '02', title: 'Impact' },
  { index: '03', title: 'Experience' },
  { index: '04', title: 'Selected work' },
  { index: '05', title: 'Toolbox' },
  { index: '06', title: 'Certifications' },
  { index: '07', title: 'Education' },
]
---

<Base
  title={`Résumé — ${site.name}`}
  description={`Résumé of ${site.name}, ${site.role} — Azure and AWS platforms built with Terraform, Kubernetes, and CI/CD.`}
>
  <div class="resume">
    <article class="rz-sheet">
      <header class="rz-head">
        <p class="rz-kicker">// résumé</p>
        <h1 class="rz-name">{site.name}</h1>
        <p class="rz-role">{site.role}</p>
        <p class="rz-headline">{headline}</p>
        <ul class="rz-contacts">
          {
            contacts.map(contact => (
              <li>
                <a href={contact.href} rel="me">
                  {contact.label}
                </a>
              </li>
            ))
          }
        </ul>
      </header>

      <div class="rz-actions">
        <a class="rz-btn rz-btn--solid" href="/resume.pdf" download>
          Download PDF ↓
        </a>
        <button class="rz-btn" type="button" id="rz-print">Print</button>
        <span class="rz-updated">updated {updated}</span>
      </div>

      <section class="rz-row rz-row--first" aria-labelledby="rz-summary">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[0].index}</span>
          <h2 id="rz-summary">{sections[0].title}</h2>
        </div>
        <div class="rz-col">
          <p class="rz-lede">{summary}</p>
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-impact">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[1].index}</span>
          <h2 id="rz-impact">{sections[1].title}</h2>
        </div>
        <div class="rz-col">
          <dl class="rz-metrics">
            {
              metrics.map(metric => (
                <div class="rz-metric">
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-experience">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[2].index}</span>
          <h2 id="rz-experience">{sections[2].title}</h2>
        </div>
        <div class="rz-col rz-col--stack">
          {
            experience.map(entry => (
              <div class="rz-entry">
                <div class="rz-entry__head">
                  <h3>
                    {entry.role}
                    <span class="rz-at"> · </span>
                    <span class="rz-org">{entry.company}</span>
                  </h3>
                  <p class="rz-period">{entry.period}</p>
                </div>
                <ul class="rz-bullets">
                  {entry.bullets.map(bullet => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-work">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[3].index}</span>
          <h2 id="rz-work">{sections[3].title}</h2>
        </div>
        <div class="rz-col rz-col--stack">
          {
            resumeProjects.map(project => (
              <div class="rz-entry rz-entry--project">
                <div class="rz-entry__head">
                  <h3>{project.title}</h3>
                  {project.github && (
                    <p class="rz-period">
                      <a href={project.github}>{repo(project.github)}</a>
                    </p>
                  )}
                </div>
                <p class="rz-tagline">{project.tagline}</p>
                <ul class="rz-chips">
                  {project.stack.map(tool => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-toolbox">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[4].index}</span>
          <h2 id="rz-toolbox">{sections[4].title}</h2>
        </div>
        <div class="rz-col">
          <dl class="rz-skills">
            {
              skills.map(category => (
                <div class="rz-skill">
                  <dt>{category.name.toLowerCase()}</dt>
                  <dd>{category.tools.join(' · ')}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-certs">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[5].index}</span>
          <h2 id="rz-certs">{sections[5].title}</h2>
        </div>
        <div class="rz-col">
          <ul class="rz-certs">
            {
              certifications.map(cert => (
                <li>
                  <a href={cert.verifyUrl} rel="noopener">
                    {cert.badge && (
                      <img
                        src={cert.badge}
                        alt=""
                        width="32"
                        height="32"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span>
                      <span class="rz-cert__title">{cert.title}</span>
                      <span class="rz-cert__meta">
                        {cert.issuer} · {formatMonth(cert.date)}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="rz-row" aria-labelledby="rz-education">
        <div class="rz-rail">
          <span class="rz-idx" aria-hidden="true">{sections[6].index}</span>
          <h2 id="rz-education">{sections[6].title}</h2>
        </div>
        <div class="rz-col">
          <ul class="rz-education">
            {
              education.map(entry => (
                <li>
                  <span class="rz-edu__degree">
                    {entry.url ? (
                      <a href={entry.url}>{entry.degree}</a>
                    ) : (
                      entry.degree
                    )}
                  </span>
                  <span class="rz-edu__meta">
                    {entry.institution} · {entry.period}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <p class="rz-foot">
        Generated from muyideen.dev — the live version of this document is at
        <a href={`${site.url}/resume`}>{bare(site.url)}/resume</a>.
      </p>
    </article>
  </div>
</Base>

<script>
  document
    .getElementById('rz-print')
    ?.addEventListener('click', () => window.print())
</script>

<style is:global>
  /* ── Résumé document ──────────────────────────────────────────────────────
     One markup tree, two renderings. On screen it inherits the control-plane
     dark theme; in print every colour token flips to paper and the site
     chrome drops away, so `window.print()` and Chrome's --print-to-pdf both
     yield the same A4 document that ships as /resume.pdf. */
  .resume {
    --rz-ink: #ffffff;
    --rz-body: #d6dae0;
    --rz-muted: #8a919b;
    --rz-rule: rgb(255 255 255 / 0.09);
    --rz-accent: #fbbf24;
    --rz-chip-bg: #171b23;
    --rz-chip-fg: #a9b0ba;

    padding: 8rem 1.5rem 5rem;
  }

  .rz-sheet {
    margin-inline: auto;
    max-width: 1000px;
    color: var(--rz-body);
  }

  /* ── Masthead ───────────────────────────────────────────────────────── */
  .rz-kicker {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--rz-accent);
    margin-bottom: 1.25rem;
  }

  .rz-name {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--rz-ink);
  }

  .rz-role {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--rz-accent);
    margin-top: 0.75rem;
  }

  .rz-headline {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--rz-muted);
    text-wrap: balance;
  }

  .rz-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .rz-contacts a {
    color: var(--rz-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .rz-contacts a:hover {
    color: var(--rz-ink);
  }

  /* ── Download / print bar (screen only) ─────────────────────────────── */
  .rz-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .rz-btn {
    display: inline-block;
    border: 1px solid var(--rz-rule);
    border-radius: 6px;
    padding: 0.625rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--rz-body);
    background: none;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .rz-btn:hover {
    color: var(--rz-ink);
    border-color: rgb(251 191 36 / 0.5);
  }
  .rz-btn--solid {
    background: var(--rz-accent);
    border-color: var(--rz-accent);
    color: #0b0d10;
    font-weight: 600;
  }
  .rz-btn--solid:hover {
    color: #0b0d10;
    transform: translateY(-2px);
  }

  .rz-updated {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--rz-muted);
  }

  /* ── Section rows: label rail + content column ──────────────────────── */
  .rz-row {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 2.5rem;
    border-top: 1px solid var(--rz-rule);
    padding: 2.25rem 0;
  }
  .rz-row--first {
    margin-top: 3.5rem;
  }

  .rz-rail {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    position: sticky;
    top: 5rem;
    align-self: start;
    height: max-content;
  }
  .rz-idx {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--rz-accent);
  }
  .rz-rail h2 {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--rz-ink);
  }

  .rz-col--stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .rz-lede {
    max-width: 74ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  /* ── Impact numbers ─────────────────────────────────────────────────── */
  .rz-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--rz-rule);
    border: 1px solid var(--rz-rule);
    border-radius: 6px;
    overflow: hidden;
  }
  .rz-metric {
    background: #0b0d10;
    padding: 1.125rem 1.25rem;
  }
  .rz-metric dt {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--rz-accent);
    font-variant-numeric: tabular-nums;
  }
  .rz-metric dd {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--rz-muted);
  }

  /* ── Experience & projects ──────────────────────────────────────────── */
  .rz-entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  .rz-entry__head h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--rz-ink);
  }
  .rz-at {
    color: var(--rz-accent);
  }
  .rz-org {
    font-weight: 500;
    color: var(--rz-body);
  }
  .rz-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--rz-muted);
  }
  .rz-period a {
    color: inherit;
    text-decoration: none;
  }
  .rz-period a:hover {
    color: var(--rz-ink);
  }

  .rz-bullets {
    margin-top: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 1px solid var(--rz-rule);
    padding-left: 1.125rem;
  }
  .rz-bullets li {
    position: relative;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--rz-muted);
  }
  .rz-bullets li::before {
    content: '–';
    position: absolute;
    left: -1.125rem;
    font-family: var(--font-mono);
    color: var(--rz-accent);
  }

  .rz-tagline {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--rz-muted);
  }

  .rz-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .rz-chips li {
    border: 1px solid var(--rz-rule);
    background: var(--rz-chip-bg);
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--rz-chip-fg);
  }

  /* ── Toolbox ────────────────────────────────────────────────────────── */
  .rz-skills {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .rz-skill {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    gap: 0.75rem;
    font-size: 0.9375rem;
  }
  .rz-skill dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--rz-accent);
  }
  .rz-skill dd {
    line-height: 1.6;
    color: var(--rz-muted);
  }

  /* ── Certifications ─────────────────────────────────────────────────── */
  .rz-certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem 2rem;
  }
  .rz-certs a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .rz-certs img {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    object-fit: contain;
  }
  .rz-cert__title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--rz-ink);
    transition: color 0.15s ease;
  }
  .rz-certs a:hover .rz-cert__title {
    color: var(--rz-accent);
  }
  .rz-cert__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--rz-muted);
  }

  /* ── Education ──────────────────────────────────────────────────────── */
  .rz-education {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .rz-edu__degree {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--rz-ink);
  }
  .rz-edu__degree a {
    color: inherit;
    text-decoration: none;
  }
  .rz-edu__degree a:hover {
    color: var(--rz-accent);
  }
  .rz-edu__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--rz-muted);
  }

  .rz-foot {
    display: none;
  }

  @media (max-width: 720px) {
    .rz-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .rz-rail {
      position: static;
    }
    .rz-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rz-certs,
    .rz-skill {
      grid-template-columns: minmax(0, 1fr);
    }
    .rz-skill dt {
      color: var(--rz-accent);
    }
  }

  /* ── Print: same document, on paper ─────────────────────────────────── */
  @page {
    size: A4;
    margin: 13mm 12mm;
  }

  @media print {
    html,
    body {
      background: #fff !important;
    }

    /* Site chrome is not part of the document. */
    body > header,
    body > footer,
    .rz-actions,
    .rz-kicker,
    .rz-certs img {
      display: none !important;
    }

    .resume {
      --rz-ink: #0d0f13;
      --rz-body: #23262c;
      --rz-muted: #4e545d;
      --rz-rule: #dcdfe4;
      --rz-accent: #9a5b06;
      --rz-chip-bg: #f4f5f7;
      --rz-chip-fg: #3f444c;

      padding: 0;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      font-size: 10pt;
    }

    .rz-sheet {
      max-width: none;
    }

    .rz-name {
      font-size: 25pt;
      letter-spacing: -0.025em;
    }
    .rz-role {
      font-size: 9.5pt;
      margin-top: 0.35rem;
    }
    .rz-headline {
      font-size: 10.5pt;
      max-width: 60ch;
      margin-top: 0.5rem;
    }
    .rz-contacts {
      font-size: 8.2pt;
      margin-top: 0.7rem;
      gap: 0.25rem 1.1rem;
    }

    .rz-row {
      grid-template-columns: 108px minmax(0, 1fr);
      gap: 1.25rem;
      padding: 0.7rem 0;
    }
    .rz-row--first {
      margin-top: 0.85rem;
    }
    .rz-rail {
      position: static;
      gap: 0.45rem;
      break-after: avoid;
    }
    .rz-rail h2 {
      font-size: 8.4pt;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .rz-idx {
      font-size: 7.5pt;
    }

    .rz-col--stack {
      gap: 0.85rem;
    }
    .rz-lede {
      font-size: 10pt;
      line-height: 1.5;
      max-width: none;
    }

    .rz-metrics {
      border-radius: 4px;
    }
    .rz-metric {
      background: #fff;
      padding: 0.5rem 0.7rem;
    }
    .rz-metric dt {
      font-size: 15pt;
    }
    .rz-metric dd {
      font-size: 7.6pt;
      margin-top: 0.2rem;
    }

    /* Keep a role and its bullets together; never orphan a heading. */
    .rz-entry {
      break-inside: avoid;
    }
    .rz-entry__head h3 {
      font-size: 10pt;
    }
    .rz-period {
      font-size: 8pt;
    }
    .rz-bullets {
      margin-top: 0.35rem;
      gap: 0.22rem;
      padding-left: 0.8rem;
    }
    .rz-bullets li {
      font-size: 9.6pt;
      line-height: 1.45;
    }
    .rz-bullets li::before {
      left: -0.8rem;
    }
    .rz-tagline {
      font-size: 9.6pt;
      line-height: 1.45;
      margin-top: 0.15rem;
    }
    .rz-chips {
      gap: 0.2rem;
      margin-top: 0.3rem;
    }
    .rz-chips li {
      font-size: 7pt;
      padding: 0.08rem 0.3rem;
    }

    .rz-skills {
      gap: 0.28rem;
    }
    .rz-skill {
      grid-template-columns: 84px minmax(0, 1fr);
      font-size: 9.6pt;
    }
    .rz-skill dt {
      font-size: 7.8pt;
    }

    .rz-certs {
      gap: 0.4rem 1.5rem;
    }
    .rz-cert__title {
      font-size: 9.1pt;
    }
    .rz-cert__meta {
      font-size: 7.4pt;
    }

    .rz-education {
      gap: 0.4rem;
    }
    .rz-edu__degree {
      font-size: 9.6pt;
    }
    .rz-edu__meta {
      font-size: 7.6pt;
    }

    /* Links carry no colour on paper — the URL row up top does that job. */
    .rz-contacts a,
    .rz-period a,
    .rz-certs a,
    .rz-edu__degree a {
      color: inherit;
    }

    .rz-foot {
      display: block;
      margin-top: 0.9rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--rz-rule);
      font-family: var(--font-mono);
      font-size: 7.4pt;
      color: var(--rz-muted);
    }
    .rz-foot a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
