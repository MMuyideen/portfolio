---
import Base from '../../layouts/Base.astro'
import { getPublishedPosts, formatDate, readingTime } from '../../lib/posts'
import { site } from '../../lib/site'

const posts = await getPublishedPosts()
const byYear = new Map<number, typeof posts>()
for (const post of posts) {
  const year = post.data.date.getUTCFullYear()
  byYear.set(year, [...(byYear.get(year) ?? []), post])
}
---

<Base
  title={`Blog — ${site.name}`}
  description="Writing on DevOps, cloud platforms, Terraform, Kubernetes, and CI/CD."
>
  <div class="mx-auto max-w-[1080px] px-6 pb-20 pt-32">
    <p class="mb-4 font-mono text-sm text-accent">// writing</p>
    <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
      Blog
    </h1>
    <p class="mt-4 max-w-[58ch] leading-relaxed text-muted">
      Notes from building and running cloud platforms — Terraform, Kubernetes,
      GitOps, and the occasional migration war story.
    </p>

    {
      [...byYear.entries()].map(([year, yearPosts]) => (
        <section class="mt-12">
          <h2 class="mb-3 font-mono text-sm text-muted">{year}</h2>
          <ul class="divide-y divide-line border-y border-line">
            {yearPosts.map(post => (
              <li>
                <a href={`/blog/${post.id}`} class="group block py-5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="font-medium text-white transition-colors group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    <p class="font-mono text-xs text-muted">
                      {formatDate(post.data.date)} · {readingTime(post.body)}{' '}
                      min
                    </p>
                  </div>
                  {post.data.excerpt && (
                    <p class="mt-1.5 max-w-[75ch] text-sm leading-relaxed text-muted">
                      {post.data.excerpt}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
